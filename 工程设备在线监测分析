// ═══════════════════════════════════════════════
// RENDER SPECTRUM
// ═══════════════════════════════════════════════
function renderSpectrum(){
  fillEqSel('specEqSel');
  refreshSpectrum();
}

function refreshSpectrum(){
  const eqId=$id('specEqSel')?.value||EQUIPMENT[0].id;
  const eq=EQUIPMENT.find(e=>e.id===eqId)||EQUIPMENT[0];
  drawSpectrum('specCanvas',eq.specData,eq.status==='err'?'#ff1744':eq.status==='warn'?'#ffab00':'#00d4ff');
  // Waterfall
  const wfData=[];
  for(let i=0;i<15;i++)wfData.push(genSpectrum(eq));
  drawWaterfall('waterfallCanvas',wfData);
  // Spectrum info
  const maxAmp=Math.max(...eq.specData.map(d=>d.amp));
  const peakFreq=eq.specData.reduce((best,d)=>d.amp>best.amp?d:best,{f:0,amp:0});
  const rms=Math.sqrt(eq.specData.reduce((s,d)=>s+d.amp*d.amp,0)/eq.specData.length);
  $id('specInfo').innerHTML=`
    <div class="spectrum-stat"><div class="label">通频值</div><div class="value" style="color:var(--cyan)">${(maxAmp*10).toFixed(2)} mm/s</div></div>
    <div class="spectrum-stat"><div class="label">主频率</div><div class="value" style="color:var(--amber)">${peakFreq.f} Hz</div></div>
    <div class="spectrum-stat"><div class="label">RMS</div><div class="value" style="color:var(--green)">${(rms*10).toFixed(2)} mm/s</div></div>
  `;
  // Feature values
  const features=[
    {name:'有效值 (RMS)',val:(eq.vib.rms).toFixed(2)+' mm/s',status:eq.vib.rms>4?'err':eq.vib.rms>3?'warn':'ok'},
    {name:'峰值 (Peak)',val:(eq.vib.peak).toFixed(2)+' mm/s',status:eq.vib.peak>7?'err':'ok'},
    {name:'峰峰值 (P-P)',val:(eq.vib.peak*2).toFixed(2)+' mm/s',status:'ok'},
    {name:'1×幅值',val:(peakFreq.amp*10).toFixed(2)+' mm/s',status:peakFreq.amp>1?'warn':'ok'},
    {name:'1×相位',val:(Math.random()*360).toFixed(1)+'°',status:'ok'},
    {name:'2×幅值',val:(maxAmp*5).toFixed(2)+' mm/s',status:'ok'},
    {name:'波峰因数',val:(eq.vib.peak/eq.vib.rms).toFixed(2),status:'ok'},
