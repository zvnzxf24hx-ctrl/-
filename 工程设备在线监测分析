function addAgentMsg(type,tag,text){
  agentMessages.push({type,tag,text});
  renderAgentMsgs();
}

function clearAgent(){agentMessages=[];renderAgent()}

function sendAgentMsg(){
  const input=$id('agentInput');
  const q=input.value.trim();if(!q)return;
  input.value='';
  addAgentMsg('system','USER',q);
  // Simulate agent thinking
  setTimeout(()=>{
    processAgentQuery(q);
  },500);
}

function processAgentQuery(q){
  const lowerQ=q.toLowerCase();
  // Find equipment mentioned
  const eqMatch=EQUIPMENT.find(e=>lowerQ.includes(e.id.toLowerCase())||lowerQ.includes(e.name));
  if(lowerQ.includes('诊断')||lowerQ.includes('分析')||lowerQ.includes('检查')){
    if(eqMatch){diagnoseEquipment(eqMatch)}
    else{addAgentMsg('system','AGENT','请指定设备编号，如"分析V-001"或"诊断4#蝶阀"');}
  }else if(lowerQ.includes('振动')&&(lowerQ.includes('异常')||lowerQ.includes('原因'))){
    if(eqMatch){diagnoseEquipment(eqMatch)}
    else{addAgentMsg('reasoning','REASONING','正在分析所有设备的振动数据...');setTimeout(()=>diagnoseAll(),800)}
  }else if(lowerQ.includes('趋势')||lowerQ.includes('变化')){
    const eq=eqMatch||EQUIPMENT[0];
    analyzeTrend(eq);
  }else if(lowerQ.includes('频谱')||lowerQ.includes('频率')){
    const eq=eqMatch||EQUIPMENT[0];
    analyzeSpectrum(eq);
  }else{
    addAgentMsg('system','AGENT','我理解您的问题。请尝试以下指令：<ul><li>"分析V-001的振动" - 分析指定设备</li><li>"自动诊断" - 全设备扫描</li><li>"V-004频谱分析" - 频谱诊断</li><li>"趋势分析" - 历史趋势</li></ul>');
  }
}

function runAutoDiagnosis(){
  addAgentMsg('system','AGENT','🔍 启动全设备自动诊断...');
  setTimeout(()=>{
    addAgentMsg('data','DATA COLLECTOR','正在采集所有设备的实时监测数据...');
    setTimeout(()=>{
      addAgentMsg('reasoning','FEATURE EXTRACT','提取振动特征值：RMS、Peak、1×幅值、2×幅值、频谱能量分布...');
      setTimeout(()=>{
        diagnoseAll();
      },600);
    },500);
  },300);
}

function diagnoseAll(){
  const errEqs=EQUIPMENT.filter(e=>e.status==='err');
  const warnEqs=EQUIPMENT.filter(e=>e.status==='warn');
  const okEqs=EQUIPMENT.filter(e=>e.status==='ok');
  if(errEqs.length){
    errEqs.forEach(eq=>{
      addAgentMsg('error','FAULT DETECTED','⚠️ <strong>'+eq.name+'('+eq.id+')</strong> 检测到严重异常！');
      setTimeout(()=>diagnoseEquipment(eq),200);
    });
  }
  if(warnEqs.length){
    warnEqs.forEach(eq=>{
      addAgentMsg('warning','WARNING','⚡ <strong>'+eq.name+'('+eq.id+')</strong> 运行参数偏高，建议关注。');
      setTimeout(()=>diagnoseEquipment(eq),200);
    });
  }
  setTimeout(()=>{
    addAgentMsg('result','DIAGNOSIS SUMMARY',
      '<strong>诊断完成</strong><ul>'+
      '<li>正常设备：'+okEqs.length+'台</li>'+
      '<li>预警设备：'+warnEqs.length+'台</li>'+
      '<li>故障设备：'+errEqs.length+'台</li>'+
      '<li>建议：'+(errEqs.length?'立即安排检修 '+errEqs.map(e=>e.name).join('、'):'系统运行正常，继续保持监测')+'</li></ul>'
    );
  },400);
}

function diagnoseEquipment(eq){
  addAgentMsg('data','DATA','设备 '+eq.name+'('+eq.id+') 实时数据：振动 '+eq.vib.val.toFixed(1)+' mm/s | 压力 '+eq.press.in.toFixed(1)+' bar | 噪音 '+eq.noise.val.toFixed(0)+' dB | 健康度 '+eq.health+'%');
  // Reasoning chain
  addAgentMsg('reasoning','STEP 1: 阈值对比',
    '振动有效值 '+eq.vib.val.toFixed(1)+' mm/s '+
    (eq.vib.val>THRESHOLDS.vib.err?'<span style="color:var(--red)">超过危险阈值 '+THRESHOLDS.vib.err+'</span>':
    eq.vib.val>THRESHOLDS.vib.warn?'<span style="color:var(--amber)">超过预警阈值 '+THRESHOLDS.vib.warn+'</span>':
    '<span style="color:var(--green)">在正常范围内</span>')
  );
  addAgentMsg('reasoning','STEP 2: 频谱分析',
    '频谱中 1× 频率分量'+(eq.status==='err'?'显著增大，伴有亚谐波分量，疑似存在转子不平衡和气蚀现象':'基本正常')+
    '；2× 频率分量'+(eq.status==='err'?'偏高，提示可能存在对中问题':'在正常范围内')
  );
  addAgentMsg('reasoning','STEP 3: 趋势分析',
    '近24小时振动趋势呈'+(eq.status==='err'?'明显上升':eq.status==='warn'?'缓慢上升':'平稳')+
    '态势，'+(eq.status==='err'?'需要立即关注':'可继续监测')
  );
  // Result
  if(eq.status==='err'){
    addAgentMsg('error','DIAGNOSIS',
      '<strong>诊断结论：'+eq.name+'('+eq.id+')</strong><ul>'+
      '<li>主要故障：转子不平衡 + 气蚀（置信度 87%）</li>'+
      '<li>次要故障：对中偏差（置信度 62%）</li>'+
      '<li>建议措施：立即停机检查阀芯/叶轮，检查密封面磨损情况，必要时更换关键部件</li>'+
      '<li>预计影响：如不处理，72小时内可能导致密封失效</li></ul>'
    );
  }else if(eq.status==='warn'){
    addAgentMsg('warning','DIAGNOSIS',
      '<strong>诊断结论：'+eq.name+'('+eq.id+')</strong><ul>'+
      '<li>振动偏高，可能原因：轻微不平衡或轴承初期磨损</li>'+
      '<li>建议：加强监测频率，安排下次停机时检修</li>'+
      '<li>预计可继续运行：建议7天内安排检修</li></ul>'
    );
  }else{
    addAgentMsg('result','DIAGNOSIS',
      '<strong>'+eq.name+'('+eq.id+')</strong> 运行状态良好，各项指标在正常范围内。建议按常规周期继续监测。'
    );
  }
}

function analyzeTrend(eq){
  const trend=eq.vibHistory.slice(-50);
  const avg=trend.reduce((s,v)=>s+v,0)/trend.length;
  const slope=(trend[trend.length-1]-trend[0])/trend.length;
  addAgentMsg('data','TREND DATA',eq.name+' 近期振动均值: '+avg.toFixed(2)+' mm/s, 变化斜率: '+(slope>0?'+':'')+slope.toFixed(4)+' mm/s/点');
  addAgentMsg('reasoning','TREND ANALYSIS',
    slope>0.01?'趋势呈上升态势，振动在逐渐增大，建议密切关注。':
    slope<-0.01?'趋势呈下降态势，设备状态在改善。':
    '趋势平稳，设备运行稳定。'
  );
}

function analyzeSpectrum(eq){
  const peakFreq=eq.specData.reduce((best,d)=>d.amp>best.amp?d:best,{f:0,amp:0});
  addAgentMsg('data','SPECTRUM DATA',eq.name+' 频谱主峰: '+peakFreq.f+' Hz, 幅值: '+(peakFreq.amp*10).toFixed(2)+' mm/s');
  addAgentMsg('reasoning','SPECTRUM ANALYSIS',
    peakFreq.f>=45&&peakFreq.f<=55?'主频率接近1×(50Hz)，提示可能存在转子不平衡。':
    peakFreq.f>=95&&peakFreq.f<=105?'主频率接近2×(100Hz)，提示可能存在对中不良。':
    '频谱特征需要结合运行工况进一步分析。'
  );
}

