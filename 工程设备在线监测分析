<script>
// ═══════════════════════════════════════════════
// EQUIPMENT DATA MODEL
// ═══════════════════════════════════════════════
const EQUIPMENT = [
  {id:'V-001',name:'1#调流阀',type:'调流阀',health:92,status:'ok',
   vib:{val:2.8,rms:2.1,peak:4.2,unit:'mm/s'},press:{in:3.2,out:2.8,unit:'bar'},noise:{val:72,unit:'dB'},
   vibHistory:[],pressHistory:[],noiseHistory:[],specData:[],alarms:[]},
  {id:'V-002',name:'2#调流阀',type:'调流阀',health:78,status:'warn',
   vib:{val:4.5,rms:3.8,peak:7.1,unit:'mm/s'},press:{in:3.1,out:2.5,unit:'bar'},noise:{val:78,unit:'dB'},
   vibHistory:[],pressHistory:[],noiseHistory:[],specData:[],alarms:[
     {time:'14:23:05',level:'warn',msg:'振动有效值超过预警阈值 (4.5 > 4.0 mm/s)'},
     {time:'14:18:32',level:'warn',msg:'噪音值偏高 (78 dB)'}
   ]},
  {id:'V-003',name:'3#调流阀',type:'调流阀',health:96,status:'ok',
   vib:{val:1.9,rms:1.5,peak:3.0,unit:'mm/s'},press:{in:3.3,out:3.0,unit:'bar'},noise:{val:68,unit:'dB'},
   vibHistory:[],pressHistory:[],noiseHistory:[],specData:[],alarms:[]},
  {id:'V-004',name:'4#蝶阀',type:'蝶阀',health:45,status:'err',
   vib:{val:8.2,rms:6.9,peak:14.5,unit:'mm/s'},press:{in:3.0,out:1.8,unit:'bar'},noise:{val:89,unit:'dB'},
   vibHistory:[],pressHistory:[],noiseHistory:[],specData:[],alarms:[
     {time:'14:25:18',level:'err',msg:'振动严重超标！(8.2 > 7.0 mm/s 危险阈值)'},
     {time:'14:24:01',level:'err',msg:'压力损失异常 (ΔP=1.2 bar，正常<0.5)'},
     {time:'14:22:45',level:'warn',msg:'噪音超过报警阈值 (89 dB)'}
   ]},
  {id:'V-005',name:'5#闸阀',type:'闸阀',health:88,status:'ok',
   vib:{val:2.2,rms:1.8,peak:3.5,unit:'mm/s'},press:{in:3.4,out:3.1,unit:'bar'},noise:{val:65,unit:'dB'},
   vibHistory:[],pressHistory:[],noiseHistory:[],specData:[],alarms:[]},
  {id:'V-006',name:'6#止回阀',type:'止回阀',health:85,status:'ok',
   vib:{val:2.5,rms:2.0,peak:4.0,unit:'mm/s'},press:{in:3.2,out:2.9,unit:'bar'},noise:{val:70,unit:'dB'},
   vibHistory:[],pressHistory:[],noiseHistory:[],specData:[],alarms:[]},
];

// Thresholds
const THRESHOLDS = {
  vib:{warn:4.0,err:7.0},
  press:{warn:0.5,err:1.0}, // delta
  noise:{warn:80,err:90}
};

// ═══════════════════════════════════════════════
// DATA GENERATION
// ═══════════════════════════════════════════════
function initData(){
  EQUIPMENT.forEach(eq=>{
    for(let i=0;i<200;i++){
      eq.vibHistory.push(genVal(eq.vib.val,0.3));
      eq.pressHistory.push(genVal(eq.press.in,0.1));
      eq.noiseHistory.push(genVal(eq.noise.val,2));
    }
    eq.specData=genSpectrum(eq);
  });
}

function genVal(base,noise){return base+(Math.random()-0.5)*noise*2}

function genSpectrum(eq){
  const data=[];
  const baseAmp=eq.status==='err'?1.5:eq.status==='warn'?0.8:0.4;
  for(let f=0;f<500;f+=2){
    let amp=baseAmp*Math.exp(-f/200)*Math.random()*0.5;
    // Add characteristic frequencies
    if(Math.abs(f-50)<6)amp+=baseAmp*2.5*(1+Math.random()*0.2); // 1x
    if(Math.abs(f-100)<6)amp+=baseAmp*1.8*(1+Math.random()*0.2); // 2x
    if(Math.abs(f-150)<6)amp+=baseAmp*0.6; // 3x
    if(eq.status==='err'&&Math.abs(f-25)<4)amp+=baseAmp*1.2; // sub-harmonic
    if(eq.status==='err'&&Math.abs(f-350)<8)amp+=baseAmp*0.8; // high freq
    data.push({f,amp:Math.max(0,amp)});
  }
  return data;
}

function updateLiveData(){
  EQUIPMENT.forEach(eq=>{
    eq.vibHistory.shift();eq.vibHistory.push(genVal(eq.vib.val,0.3));
    eq.pressHistory.shift();eq.pressHistory.push(genVal(eq.press.in,0.1));
    eq.noiseHistory.shift();eq.noiseHistory.push(genVal(eq.noise.val,2));
    // Slowly drift values
    eq.vib.val=Math.max(0.5,eq.vib.val+(Math.random()-0.5)*0.1);
    eq.press.in=eq.press.in+(Math.random()-0.5)*0.05;
    eq.noise.val=eq.noise.val+(Math.random()-0.5)*0.5;
    eq.specData=genSpectrum(eq);
    // Update status
    if(eq.vib.val>THRESHOLDS.vib.err){eq.status='err';eq.health=Math.max(20,eq.health-1)}
    else if(eq.vib.val>THRESHOLDS.vib.warn){eq.status='warn';eq.health=Math.max(40,eq.health-0.5)}
    else{eq.status='ok';eq.health=Math.min(100,eq.health+0.1)}
    eq.health=Math.round(eq.health*10)/10;
  });
}

// ═══════════════════════════════════════════════
// CHART DRAWING
// ═══════════════════════════════════════════════
function drawWave(canvasId,data,color='#00d4ff',maxY=null,minY=null){
  const canvas=document.getElementById(canvasId);
  if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width=canvas.offsetWidth*2;
  const H=canvas.height=canvas.offsetHeight*2;
  ctx.clearRect(0,0,W,H);
  // Grid
  ctx.strokeStyle='rgba(30,42,58,.6)';ctx.lineWidth=1;
  for(let y=0;y<H;y+=H/8){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}
  for(let x=0;x<W;x+=W/10){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke()}
  if(!data||!data.length)return;
  const max=maxY||Math.max(...data)*1.2;
  const min=minY||Math.min(...data)*0.8;
  const range=max-min||1;
  // Waveform
  ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=2;
  data.forEach((v,i)=>{
    const x=i/(data.length-1)*W;
    const y=H-(v-min)/range*H*0.85-H*0.05;
    i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
  });
  ctx.stroke();
  // Glow
  ctx.strokeStyle=color.replace(')',',0.15)').replace('rgb','rgba');
  ctx.lineWidth=8;
  ctx.beginPath();
  data.forEach((v,i)=>{
    const x=i/(data.length-1)*W;
    const y=H-(v-min)/range*H*0.85-H*0.05;
    i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
  });
  ctx.stroke();
}

function drawSpectrum(canvasId,data,color='#00d4ff'){
  const canvas=document.getElementById(canvasId);
  if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width=canvas.offsetWidth*2;
  const H=canvas.height=canvas.offsetHeight*2;
  ctx.clearRect(0,0,W,H);
  // Grid
  ctx.strokeStyle='rgba(30,42,58,.6)';ctx.lineWidth=1;
  for(let y=0;y<H;y+=H/6){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}
  if(!data||!data.length)return;
  const maxAmp=Math.max(...data.map(d=>d.amp))*1.3||1;
  const bw=W/data.length;
  // Bars
  data.forEach((d,i)=>{
    const x=i*bw;
    const h=d.amp/maxAmp*H*0.9;
    const gradient=ctx.createLinearGradient(0,H-h,0,H);
    gradient.addColorStop(0,color);
    gradient.addColorStop(1,color.replace(')',',0.2)').replace('#','#'));
    ctx.fillStyle=gradient;
    ctx.fillRect(x+1,H-h,bw-2,h);
  });
  // Axis labels
  ctx.fillStyle='rgba(136,153,170,.6)';ctx.font='18px JetBrains Mono';
  const maxF=data[data.length-1]?.f||500;
  for(let f=0;f<=maxF;f+=100){
    const x=f/maxF*W;
    ctx.fillText(f+'Hz',x,H-8);
  }
}

function drawWaterfall(canvasId,historyData){
  const canvas=document.getElementById(canvasId);
  if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width=canvas.offsetWidth*2;
  const H=canvas.height=canvas.offsetHeight*2;
  ctx.clearRect(0,0,W,H);
  const rows=Math.min(historyData.length,15);
  const rowH=H/rows;
  for(let r=0;r<rows;r++){
    const data=historyData[r]||[];
    const maxAmp=Math.max(...data.map(d=>d.amp),0.1);
    const y0=r*rowH;
    data.forEach((d,i)=>{
      const x=i/(data.length||1)*W;
      const intensity=d.amp/maxAmp;
      const red=Math.round(intensity*0);const green=Math.round(intensity*212);const blue=Math.round(intensity*255);
      ctx.fillStyle=`rgba(${red},${green},${blue},${intensity*0.8+0.1})`;
      ctx.fillRect(x,y0,W/data.length,rowH);
    });
  }
  ctx.fillStyle='rgba(136,153,170,.5)';ctx.font='16px JetBrains Mono';
  ctx.fillText('时间 →',8,H-8);ctx.fillText('频率 →',8,20);
}

function drawTrend(canvasId,data,color='#00d4ff',label='',warnThresh=null,errThresh=null){
  const canvas=document.getElementById(canvasId);
  if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width=canvas.offsetWidth*2;
  const H=canvas.height=canvas.offsetHeight*2;
  ctx.clearRect(0,0,W,H);
  // Grid
  ctx.strokeStyle='rgba(30,42,58,.5)';ctx.lineWidth=1;
  for(let y=0;y<H;y+=H/6){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}
  if(!data||!data.length)return;
  const max=Math.max(...data,warnThresh||0)*1.3;
  const min=Math.min(...data)*0.7;
  const range=max-min||1;
  // Threshold lines
  if(warnThresh){
    const y=H-(warnThresh-min)/range*H*0.85-H*0.05;
    ctx.strokeStyle='rgba(255,171,0,.4)';ctx.lineWidth=2;ctx.setLineDash([8,4]);
    ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle='rgba(255,171,0,.6)';ctx.font='16px JetBrains Mono';ctx.fillText('预警',W-50,y-6);
  }
  if(errThresh){
    const y=H-(errThresh-min)/range*H*0.85-H*0.05;
    ctx.strokeStyle='rgba(255,23,68,.4)';ctx.lineWidth=2;ctx.setLineDash([8,4]);
    ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle='rgba(255,23,68,.6)';ctx.font='16px JetBrains Mono';ctx.fillText('危险',W-50,y-6);
  }
  // Fill area
  ctx.beginPath();
  data.forEach((v,i)=>{
    const x=i/(data.length-1)*W;
    const y=H-(v-min)/range*H*0.85-H*0.05;
    i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
  });
  ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.closePath();
  const grad=ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0,color.replace(')',',0.2)').replace('rgb','rgba').replace('#00d4ff','rgba(0,212,255,0.2)'));
  grad.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=grad;ctx.fill();
  // Line
  ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=2.5;
  data.forEach((v,i)=>{
    const x=i/(data.length-1)*W;
    const y=H-(v-min)/range*H*0.85-H*0.05;
    i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
  });
  ctx.stroke();
  // Label
  ctx.fillStyle='rgba(136,153,170,.6)';ctx.font='18px JetBrains Mono';
  ctx.fillText(label,10,24);
}

function drawGauge(canvas,value,max,label,color){
  const ctx=canvas.getContext('2d');
  const W=canvas.width=canvas.offsetWidth*2;
  const H=canvas.height=canvas.offsetHeight*2;
  ctx.clearRect(0,0,W,H);
  const cx=W/2,cy=H*0.55,r=Math.min(W,H)*0.38;
  const pct=Math.min(value/max,1);
  // Background arc
  ctx.beginPath();ctx.arc(cx,cy,r,Math.PI*0.8,Math.PI*2.2);ctx.strokeStyle='rgba(30,42,58,.6)';ctx.lineWidth=12;ctx.lineCap='round';ctx.stroke();
  // Value arc
  ctx.beginPath();ctx.arc(cx,cy,r,Math.PI*0.8,Math.PI*0.8+pct*Math.PI*1.4);ctx.strokeStyle=color;ctx.lineWidth=12;ctx.lineCap='round';ctx.stroke();
  // Text
  ctx.fillStyle=color;ctx.font='bold 28px JetBrains Mono';ctx.textAlign='center';
  ctx.fillText(value.toFixed(1),cx,cy+4);
  ctx.fillStyle='rgba(136,153,170,.6)';ctx.font='16px Noto Sans SC';
  ctx.fillText(label,cx,cy+28);
}

// ═══════════════════════════════════════════════
// RENDER DASHBOARD
// ═══════════════════════════════════════════════
function renderDashboard(){
  const okCount=EQUIPMENT.filter(e=>e.status==='ok').length;
  const warnCount=EQUIPMENT.filter(e=>e.status==='warn').length;
  const errCount=EQUIPMENT.filter(e=>e.status==='err').length;
  const avgHealth=Math.round(EQUIPMENT.reduce((s,e)=>s+e.health,0)/EQUIPMENT.length);
  $id('statCards').innerHTML=`
    <div class="stat cyan"><div class="stat-label">监测设备总数</div><div class="stat-val cyan">${EQUIPMENT.length}</div><div class="stat-sub">套在线运行</div></div>
    <div class="stat green"><div class="stat-label">正常运行</div><div class="stat-val green">${okCount}</div><div class="stat-trend up">↑ 系统稳定</div></div>
    <div class="stat ${warnCount?'amber':'green'}"><div class="stat-label">预警设备</div><div class="stat-val ${warnCount?'amber':'green'}">${warnCount}</div><div class="stat-sub">${warnCount?'需要关注':'无预警'}</div></div>
    <div class="stat ${errCount?'red':'green'}"><div class="stat-label">平均健康度</div><div class="stat-val ${avgHealth>80?'green':avgHealth>60?'amber':'red'}">${avgHealth}%</div><div class="health-bar"><div class="health-bar-fill ${avgHealth>80?'green':avgHealth>60?'amber':'red'}" style="width:${avgHealth}%"></div></div></div>
  `;
  // Equipment list
  $id('eqList').innerHTML=EQUIPMENT.map(eq=>`
    <div class="eq-item" onclick="selectEquipment('${eq.id}')">
      <div class="eq-status ${eq.status}"></div>
      <div><div class="eq-name">${eq.name}</div><div class="eq-id">${eq.id} | ${eq.type}</div></div>
      <div style="text-align:center"><div class="health-bar" style="width:80px;margin:0 auto"><div class="health-bar-fill ${eq.health>80?'green':eq.health>60?'amber':'red'}" style="width:${eq.health}%"></div></div><span style="font-family:var(--mono);font-size:.72rem;color:var(--text2)">${eq.health}%</span></div>
      <div class="eq-val ${eq.vib.val>THRESHOLDS.vib.err?'red':eq.vib.val>THRESHOLDS.vib.warn?'amber':'cyan'}">${eq.vib.val.toFixed(1)}</div>
      <div class="eq-val cyan">${eq.press.in.toFixed(1)}</div>
      <div class="eq-val ${eq.noise.val>THRESHOLDS.noise.err?'red':eq.noise.val>THRESHOLDS.noise.warn?'amber':'cyan'}">${eq.noise.val.toFixed(0)}</div>
      <div><span class="tag ${eq.status}">${eq.status==='ok'?'正常':eq.status==='warn'?'预警':'故障'}</span></div>
    </div>
  `).join('');
  // Alarms
  const allAlarms=EQUIPMENT.flatMap(eq=>eq.alarms.map(a=>({...a,eq:eq.name,id:eq.id}))).sort((a,b)=>b.time>a.time?1:-1);
  $id('alarmList').innerHTML=allAlarms.length?allAlarms.map(a=>`
    <div style="padding:.5rem .6rem;background:var(--${a.level==='err'?'red':'amber'}-dim);border-radius:var(--r);margin-bottom:.4rem;border-left:3px solid var(--${a.level==='err'?'red':'amber'})">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span style="font-weight:600;font-size:.82rem;color:var(--${a.level==='err'?'red':'amber'})">${a.id} ${a.eq}</span>
        <span style="font-family:var(--mono);font-size:.7rem;color:var(--text3)">${a.time}</span>
      </div>
      <div style="font-size:.78rem;color:var(--text2);margin-top:.2rem">${a.msg}</div>
    </div>
  `).join(''):'<div style="text-align:center;padding:2rem;color:var(--text3)">无告警事件</div>';
  // Agent badge
  const alarmCount=allAlarms.filter(a=>a.level==='err').length;
  const badge=$id('agentBadge');
  if(badge){badge.textContent=alarmCount||'';badge.className='badge '+(alarmCount?'err':'')}
}

