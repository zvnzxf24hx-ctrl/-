<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>工程设备在线监测数据分析 Agent</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0e14;--bg2:#111820;--bg3:#1a2230;--bg4:#232d3f;
  --cyan:#00d4ff;--cyan-dim:rgba(0,212,255,.15);--cyan-glow:rgba(0,212,255,.08);
  --green:#00e676;--green-dim:rgba(0,230,118,.12);
  --amber:#ffab00;--amber-dim:rgba(255,171,0,.12);
  --red:#ff1744;--red-dim:rgba(255,23,68,.12);
  --purple:#b388ff;--purple-dim:rgba(179,136,255,.12);
  --text:#e0e6ed;--text2:#8899aa;--text3:#556677;
  --border:#1e2a3a;--border2:#2a3a4e;
  --mono:'JetBrains Mono',monospace;--sans:'Noto Sans SC',sans-serif;
  --r:8px;--tr:.2s ease;
}
*{margin:0;padding:0;box-sizing:border-box}
html{font-size:14px;scroll-behavior:smooth}
body{font-family:var(--sans);background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--bg4);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--text3)}

/* Header */
.header{
  position:sticky;top:0;z-index:100;
  background:rgba(10,14,20,.92);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  padding:0 1.6rem;height:52px;
  display:flex;align-items:center;justify-content:space-between;
}
.logo{display:flex;align-items:center;gap:.7rem}
.logo-icon{
  width:32px;height:32px;border-radius:6px;
  background:linear-gradient(135deg,var(--cyan),#0088cc);
  display:flex;align-items:center;justify-content:center;
  font-size:.85rem;font-weight:700;color:#000;
  box-shadow:0 0 12px rgba(0,212,255,.3);
}
.logo-text{font-family:var(--mono);font-weight:600;font-size:1rem;color:var(--cyan);letter-spacing:.02em}
.logo-sub{font-size:.68rem;color:var(--text3);margin-left:.3rem}
.header-status{display:flex;align-items:center;gap:1.2rem}
.status-pill{
  display:flex;align-items:center;gap:.4rem;
  padding:.25rem .7rem;border-radius:20px;
  font-family:var(--mono);font-size:.72rem;font-weight:500;
}
.status-pill.live{background:var(--green-dim);color:var(--green)}
.status-pill .dot{width:6px;height:6px;border-radius:50%;background:currentColor;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.header-time{font-family:var(--mono);font-size:.78rem;color:var(--text2)}

/* Nav */
.nav{
  background:var(--bg2);border-bottom:1px solid var(--border);
  padding:0 1.6rem;display:flex;gap:0;
}
.nav-item{
  padding:.7rem 1.2rem;font-size:.82rem;font-weight:500;
  color:var(--text3);cursor:pointer;border-bottom:2px solid transparent;
  transition:var(--tr);display:flex;align-items:center;gap:.4rem;
}
.nav-item:hover{color:var(--text2)}
.nav-item.active{color:var(--cyan);border-bottom-color:var(--cyan)}
.nav-item .badge{
  font-family:var(--mono);font-size:.62rem;font-weight:600;
  padding:.1rem .35rem;border-radius:10px;
}
.nav-item .badge.warn{background:var(--amber-dim);color:var(--amber)}
.nav-item .badge.err{background:var(--red-dim);color:var(--red)}

/* Layout */
.content{padding:1rem 1.6rem;display:flex;flex-direction:column;gap:1rem}
.page{display:none}.page.active{display:block}

/* Cards */
.card{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:var(--r);overflow:hidden;
}
.card-h{
  padding:.7rem 1rem;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.card-t{font-weight:600;font-size:.88rem;display:flex;align-items:center;gap:.4rem}
.card-t .icon{font-size:1rem}
.card-body{padding:1rem}
.card-sm{padding:.6rem .8rem}

/* Grid */
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.g21{display:grid;grid-template-columns:2fr 1fr;gap:.8rem}
.g12{display:grid;grid-template-columns:1fr 2fr;gap:.8rem}

/* Stat Card */
.stat{
  background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);
  padding:1rem;position:relative;overflow:hidden;
}
.stat::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
}
.stat.cyan::before{background:var(--cyan)}
.stat.green::before{background:var(--green)}
.stat.amber::before{background:var(--amber)}
.stat.red::before{background:var(--red)}
.stat-label{font-size:.72rem;color:var(--text3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.3rem}
.stat-val{font-family:var(--mono);font-size:1.6rem;font-weight:700;line-height:1}
.stat-val.cyan{color:var(--cyan)}.stat-val.green{color:var(--green)}.stat-val.amber{color:var(--amber)}.stat-val.red{color:var(--red)}
.stat-sub{font-size:.72rem;color:var(--text3);margin-top:.3rem;font-family:var(--mono)}
.stat-trend{display:inline-flex;align-items:center;gap:.2rem;font-size:.7rem;font-family:var(--mono);margin-top:.2rem}
.stat-trend.up{color:var(--green)}.stat-trend.down{color:var(--red)}

/* Equipment List */
.eq-list{display:flex;flex-direction:column;gap:.4rem}
.eq-item{
  display:grid;grid-template-columns:40px 1fr 100px 80px 80px 80px 60px;
  align-items:center;gap:.6rem;
  padding:.5rem .8rem;border-radius:var(--r);
  background:var(--bg3);border:1px solid transparent;
  font-size:.8rem;transition:var(--tr);cursor:pointer;
}
.eq-item:hover{border-color:var(--border2);background:var(--bg4)}
.eq-item .eq-status{
  width:10px;height:10px;border-radius:50%;
  box-shadow:0 0 8px;
}
.eq-item .eq-status.ok{background:var(--green);box-shadow:0 0 8px rgba(0,230,118,.4)}
.eq-item .eq-status.warn{background:var(--amber);box-shadow:0 0 8px rgba(255,171,0,.4)}
.eq-item .eq-status.err{background:var(--red);box-shadow:0 0 8px rgba(255,23,68,.4)}
.eq-name{font-weight:600;font-size:.82rem}
.eq-id{font-family:var(--mono);font-size:.7rem;color:var(--text3)}
.eq-val{font-family:var(--mono);font-size:.78rem;text-align:right}
.eq-val.cyan{color:var(--cyan)}.eq-val.green{color:var(--green)}.eq-val.amber{color:var(--amber)}.eq-val.red{color:var(--red)}
.eq-header{
  display:grid;grid-template-columns:40px 1fr 100px 80px 80px 80px 60px;
  gap:.6rem;padding:.4rem .8rem;
  font-size:.7rem;color:var(--text3);text-transform:uppercase;letter-spacing:.05em;
  font-weight:600;
}

/* Canvas Charts */
.chart-wrap{position:relative;width:100%;background:var(--bg);border-radius:var(--r);border:1px solid var(--border);overflow:hidden}
.chart-wrap canvas{display:block;width:100%}
.chart-label{position:absolute;top:.4rem;left:.6rem;font-size:.7rem;color:var(--text3);font-family:var(--mono)}
.chart-legend{display:flex;gap:1rem;padding:.4rem .8rem;flex-wrap:wrap}
.chart-legend-item{display:flex;align-items:center;gap:.3rem;font-size:.72rem;color:var(--text2)}
.chart-legend-item .dot{width:8px;height:8px;border-radius:2px}

/* Agent Panel */
.agent-panel{display:flex;flex-direction:column;gap:.6rem}
.agent-msg{
  padding:.7rem 1rem;border-radius:var(--r);
  font-size:.82rem;line-height:1.7;
  animation:msgIn .3s ease;
}
@keyframes msgIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.agent-msg.system{background:var(--bg3);border:1px solid var(--border);color:var(--text2)}
.agent-msg.system .msg-tag{color:var(--cyan);font-family:var(--mono);font-size:.7rem;font-weight:600;display:block;margin-bottom:.3rem}
.agent-msg.reasoning{background:var(--purple-dim);border:1px solid rgba(179,136,255,.2)}
.agent-msg.reasoning .msg-tag{color:var(--purple);font-family:var(--mono);font-size:.7rem;font-weight:600;display:block;margin-bottom:.3rem}
.agent-msg.result{background:var(--green-dim);border:1px solid rgba(0,230,118,.2)}
.agent-msg.result .msg-tag{color:var(--green);font-family:var(--mono);font-size:.7rem;font-weight:600;display:block;margin-bottom:.3rem}
.agent-msg.warning{background:var(--amber-dim);border:1px solid rgba(255,171,0,.2)}
.agent-msg.warning .msg-tag{color:var(--amber);font-family:var(--mono);font-size:.7rem;font-weight:600;display:block;margin-bottom:.3rem}
.agent-msg.error{background:var(--red-dim);border:1px solid rgba(255,23,68,.2)}
.agent-msg.error .msg-tag{color:var(--red);font-family:var(--mono);font-size:.7rem;font-weight:600;display:block;margin-bottom:.3rem}
.agent-msg.data{background:var(--cyan-dim);border:1px solid rgba(0,212,255,.15)}
.agent-msg.data .msg-tag{color:var(--cyan);font-family:var(--mono);font-size:.7rem;font-weight:600;display:block;margin-bottom:.3rem}
.agent-msg ul{padding-left:1.2rem;margin:.3rem 0}
.agent-msg li{margin:.2rem 0}
.agent-msg code{font-family:var(--mono);background:rgba(0,0,0,.3);padding:.1rem .3rem;border-radius:3px;font-size:.78rem}

/* Agent Input */
.agent-input-wrap{
  display:flex;gap:.5rem;padding:.8rem 1rem;
  border-top:1px solid var(--border);background:var(--bg3);
}
.agent-input{
  flex:1;background:var(--bg);border:1px solid var(--border2);
  border-radius:var(--r);padding:.5rem .8rem;
  font-family:var(--sans);font-size:.82rem;color:var(--text);
  outline:none;transition:var(--tr);
}
.agent-input:focus{border-color:var(--cyan);box-shadow:0 0 0 2px var(--cyan-dim)}
.agent-input::placeholder{color:var(--text3)}
.agent-send{
  background:linear-gradient(135deg,var(--cyan),#0088cc);
  color:#000;border:none;border-radius:var(--r);
  padding:.5rem 1.2rem;font-family:var(--mono);
  font-weight:600;font-size:.8rem;cursor:pointer;
  transition:var(--tr);
}
.agent-send:hover{box-shadow:0 0 16px rgba(0,212,255,.3)}

/* Report */
.report-block{margin-bottom:1.2rem}
.report-title{font-family:var(--mono);font-weight:700;font-size:1rem;color:var(--cyan);margin-bottom:.6rem;padding-bottom:.4rem;border-bottom:1px solid var(--border)}
.report-table{width:100%;border-collapse:collapse;font-size:.8rem}
.report-table th{background:var(--bg4);padding:.5rem .6rem;text-align:left;font-weight:600;color:var(--text2);border:1px solid var(--border)}
.report-table td{padding:.4rem .6rem;border:1px solid var(--border);color:var(--text)}
.report-table tr:nth-child(even){background:var(--bg3)}
.score-ring{
  width:120px;height:120px;position:relative;
  display:flex;align-items:center;justify-content:center;margin:0 auto;
}
.score-ring svg{position:absolute;inset:0;transform:rotate(-90deg)}
.score-ring .score-text{
  font-family:var(--mono);font-size:2rem;font-weight:700;
  z-index:1;
}

/* Buttons */
.btn{
  display:inline-flex;align-items:center;gap:.4rem;
  padding:.45rem 1rem;border:1px solid var(--border2);
  border-radius:var(--r);background:var(--bg3);color:var(--text2);
  font-family:var(--sans);font-size:.8rem;font-weight:500;
  cursor:pointer;transition:var(--tr);
}
.btn:hover{border-color:var(--cyan);color:var(--cyan)}
.btn-cyan{background:linear-gradient(135deg,var(--cyan),#0088cc);color:#000;border-color:transparent;font-weight:600}
.btn-cyan:hover{box-shadow:0 0 16px rgba(0,212,255,.3);color:#000}
.btn-sm{padding:.3rem .7rem;font-size:.74rem}

/* Tags */
.tag{
  display:inline-flex;align-items:center;gap:.25rem;
  padding:.15rem .5rem;border-radius:4px;
  font-family:var(--mono);font-size:.68rem;font-weight:600;
}
.tag.ok{background:var(--green-dim);color:var(--green)}
.tag.warn{background:var(--amber-dim);color:var(--amber)}
.tag.err{background:var(--red-dim);color:var(--red)}
.tag.cyan{background:var(--cyan-dim);color:var(--cyan)}

/* Spectrum display */
.spectrum-info{
  display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;
  margin-top:.6rem;
}
.spectrum-stat{
  background:var(--bg3);border-radius:var(--r);padding:.5rem .7rem;
  text-align:center;
}
.spectrum-stat .label{font-size:.68rem;color:var(--text3);margin-bottom:.2rem}
.spectrum-stat .value{font-family:var(--mono);font-size:1.1rem;font-weight:700}

/* Responsive */
@media(max-width:1200px){.g4{grid-template-columns:repeat(2,1fr)}.g21,.g12{grid-template-columns:1fr}}
@media(max-width:768px){
  .g4,.g3,.g2{grid-template-columns:1fr}
  .eq-item{grid-template-columns:30px 1fr 60px 60px}
  .eq-header{grid-template-columns:30px 1fr 60px 60px}
  .content{padding:.8rem}.header{padding:0 1rem}
}

/* Animation */
.fade-in{animation:fadeIn .4s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* Loading dots */
.dots::after{content:'';animation:dots 1.5s infinite}
@keyframes dots{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}

/* Health bar */
.health-bar{height:6px;background:var(--bg);border-radius:3px;overflow:hidden;margin-top:.3rem}
.health-bar-fill{height:100%;border-radius:3px;transition:width .6s ease}
.health-bar-fill.green{background:linear-gradient(90deg,var(--green),#00c853)}
.health-bar-fill.amber{background:linear-gradient(90deg,var(--amber),#ff8f00)}
.health-bar-fill.red{background:linear-gradient(90deg,var(--red),#d50000)}

/* Watermark effect */
.watermark{
  position:fixed;bottom:1rem;right:1.6rem;
  font-family:var(--mono);font-size:.65rem;color:var(--text3);
  opacity:.4;
}
</style>
</head>
<body>

<header class="header">
  <div class="logo">
    <div class="logo-icon">CA</div>
    <span class="logo-text">CA6500 Monitor</span>
    <span class="logo-sub">工程设备在线监测数据分析 Agent</span>
  </div>
  <div class="header-status">
    <div class="status-pill live"><span class="dot"></span>实时监测中</div>
    <div class="header-time" id="headerTime"></div>
  </div>
</header>

<nav class="nav" id="nav">
  <div class="nav-item active" data-page="dashboard">📊 总览</div>
  <div class="nav-item" data-page="monitor">📡 实时监测</div>
  <div class="nav-item" data-page="spectrum">📈 频谱分析</div>
  <div class="nav-item" data-page="trend">📉 趋势分析</div>
  <div class="nav-item" data-page="agent">🤖 故障诊断 Agent <span class="badge warn" id="agentBadge">2</span></div>
  <div class="nav-item" data-page="report">📋 健康评估</div>
</nav>

<div class="content">

  <!-- DASHBOARD -->
  <div class="page active" id="page-dashboard">
    <div class="g4 fade-in" id="statCards"></div>
    <div class="g21 fade-in" style="margin-top:.8rem">
      <div class="card">
        <div class="card-h">
          <div class="card-t"><span class="icon">🏭</span> 设备运行状态</div>
          <span class="tag ok">系统正常</span>
        </div>
        <div class="card-body">
          <div class="eq-header">
            <span></span><span>设备名称</span><span>健康度</span><span>振动(mm/s)</span><span>压力(bar)</span><span>噪音(dB)</span><span>状态</span>
          </div>
          <div class="eq-list" id="eqList"></div>
        </div>
      </div>
      <div class="card">
        <div class="card-h"><div class="card-t"><span class="icon">⚠️</span> 告警事件</div></div>
        <div class="card-body" id="alarmList"></div>
      </div>
    </div>
  </div>

  <!-- REAL-TIME MONITOR -->
  <div class="page" id="page-monitor">
    <div class="g2 fade-in">
      <div class="card">
        <div class="card-h"><div class="card-t"><span class="icon">📳</span> 振动波形 (阀体振动)</div>
          <select id="vibEqSel" style="background:var(--bg);color:var(--text);border:1px solid var(--border2);border-radius:4px;padding:.2rem .5rem;font-size:.76rem"></select>
        </div>
        <div class="card-body"><div class="chart-wrap"><canvas id="vibWaveCanvas" height="200"></canvas></div></div>
      </div>
      <div class="card">
        <div class="card-h"><div class="card-t"><span class="icon">🔵</span> 压力脉动</div></div>
        <div class="card-body"><div class="chart-wrap"><canvas id="pressCanvas" height="200"></canvas></div></div>
      </div>
    </div>
    <div class="g2 fade-in" style="margin-top:.8rem">
      <div class="card">
        <div class="card-h"><div class="card-t"><span class="icon">🔊</span> 噪音监测</div></div>
        <div class="card-body"><div class="chart-wrap"><canvas id="noiseCanvas" height="200"></canvas></div></div>
      </div>
      <div class="card">
        <div class="card-h"><div class="card-t"><span class="icon">🌡️</span> 多参数实时仪表</div></div>
        <div class="card-body" id="gaugePanel"></div>
      </div>
    </div>
  </div>

  <!-- SPECTRUM -->
  <div class="page" id="page-spectrum">
    <div class="g21 fade-in">
      <div class="card">
        <div class="card-h"><div class="card-t"><span class="icon">📊</span> 频谱图 (FFT)</div>
          <div style="display:flex;gap:.4rem">
            <select id="specEqSel" style="background:var(--bg);color:var(--text);border:1px solid var(--border2);border-radius:4px;padding:.2rem .5rem;font-size:.76rem"></select>
            <button class="btn btn-sm" onclick="refreshSpectrum()">刷新</button>
          </div>
        </div>
        <div class="card-body">
          <div class="chart-wrap"><canvas id="specCanvas" height="260"></canvas></div>
          <div class="spectrum-info" id="specInfo"></div>
        </div>
      </div>
      <div>
        <div class="card" style="margin-bottom:.8rem">
          <div class="card-h"><div class="card-t"><span class="icon">🌊</span> 频谱瀑布图</div></div>
          <div class="card-body"><div class="chart-wrap"><canvas id="waterfallCanvas" height="200"></canvas></div></div>
        </div>
        <div class="card">
          <div class="card-h"><div class="card-t"><span class="icon">📐</span> 特征值</div></div>
          <div class="card-body" id="featureVals"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- TREND -->
  <div class="page" id="page-trend">
    <div class="card fade-in">
      <div class="card-h">
        <div class="card-t"><span class="icon">📉</span> 历史趋势分析</div>
        <div style="display:flex;gap:.4rem">
          <select id="trendParam" style="background:var(--bg);color:var(--text);border:1px solid var(--border2);border-radius:4px;padding:.2rem .5rem;font-size:.76rem">
            <option value="vib">振动</option><option value="press">压力脉动</option><option value="noise">噪音</option>
          </select>
          <select id="trendRange" style="background:var(--bg);color:var(--text);border:1px solid var(--border2);border-radius:4px;padding:.2rem .5rem;font-size:.76rem">
            <option value="1h">近1小时</option><option value="24h" selected>近24小时</option><option value="7d">近7天</option>
          </select>
          <button class="btn btn-sm" onclick="refreshTrend()">刷新</button>
        </div>
      </div>
      <div class="card-body"><div class="chart-wrap"><canvas id="trendCanvas" height="280"></canvas></div></div>
    </div>
    <div class="g3 fade-in" style="margin-top:.8rem">
      <div class="card"><div class="card-h"><div class="card-t">振动趋势</div></div><div class="card-body"><div class="chart-wrap"><canvas id="trendVibMini" height="140"></canvas></div></div></div>
      <div class="card"><div class="card-h"><div class="card-t">压力趋势</div></div><div class="card-body"><div class="chart-wrap"><canvas id="trendPressMini" height="140"></canvas></div></div></div>
      <div class="card"><div class="card-h"><div class="card-t">噪音趋势</div></div><div class="card-body"><div class="chart-wrap"><canvas id="trendNoiseMini" height="140"></canvas></div></div></div>
    </div>
  </div>

  <!-- AGENT -->
  <div class="page" id="page-agent">
    <div class="g21 fade-in">
      <div class="card" style="display:flex;flex-direction:column;max-height:calc(100vh - 160px)">
        <div class="card-h"><div class="card-t"><span class="icon">🤖</span> 故障诊断 Agent</div>
          <div style="display:flex;gap:.4rem">
            <button class="btn btn-sm btn-cyan" onclick="runAutoDiagnosis()">🔍 自动诊断</button>
            <button class="btn btn-sm" onclick="clearAgent()">清空</button>
          </div>
        </div>
        <div class="card-body agent-panel" id="agentChat" style="flex:1;overflow-y:auto"></div>
        <div class="agent-input-wrap">
