      drawGauge($id('gVib'),eq.vib.val,10,'振动 mm/s',eq.vib.val>4?'#ff1744':'#00d4ff');
      drawGauge($id('gPress'),eq.press.in,5,'压力 bar','#b388ff');
      drawGauge($id('gNoise'),eq.noise.val,100,'噪音 dB',eq.noise.val>80?'#ffab00':'#00e676');
    }catch(e){}
  }
},2000);

// Initial render
renderDashboard();
</script>
