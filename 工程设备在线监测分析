function renderAgentMsgs(){
  const chat=$id('agentChat');
  chat.innerHTML=agentMessages.map(m=>`<div class="agent-msg ${m.type}"><span class="msg-tag">${m.tag}</span>${m.text}</div>`).join('');
  chat.scrollTop=chat.scrollHeight;
